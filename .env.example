# ==============================================================
# Skill Jobs - Environment Configuration
# ==============================================================

# Django Secret Key (Use a strong secret key in production)
SECRET_KEY=django-insecure-skill-jobs-change-this-for-production-key-2026

# Debug Mode: Set to False in production
DEBUG=False

# Allowed Hosts: Comma-separated hosts or '*' for all Vercel domains
ALLOWED_HOSTS=*

# --------------------------------------------------------------
# Neon PostgreSQL Database Connection
# --------------------------------------------------------------
# IMPORTANT: In serverless environments (Vercel), use Neon's POOLED connection string (-pooler).
# In your Neon console -> Dashboard -> Connection Details -> check "Pooled connection".
DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# CORS Configuration
CORS_ALLOW_ALL_ORIGINS=True
ALLOWED_ORIGINS=https://your-site.vercel.app,http://localhost:5173

# Server Port
PORT=5000
