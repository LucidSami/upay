{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "skilljobs-web": {
      "root": "client",
      "framework": "vite",
      "buildCommand": "npm install && npm run build"
    },
    "skilljobs-api": {
      "root": "server_django",
      "framework": "django",
      "buildCommand": "pip install -r requirements.txt && python manage.py collectstatic --no-input && python manage.py migrate && python manage.py seed_data"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "skilljobs-api"
      }
    },
    {
      "source": "/django-admin/(.*)",
      "destination": {
        "service": "skilljobs-api"
      }
    },
    {
      "source": "/static/(.*)",
      "destination": {
        "service": "skilljobs-api"
      }
    },
    {
      "source": "/assets/(.*)",
      "destination": {
        "service": "skilljobs-web"
      }
    },
    {
      "source": "/(.*\\.[a-zA-Z0-9]+)$",
      "destination": {
        "service": "skilljobs-web"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "skilljobs-web",
        "path": "/index.html"
      }
    }
  ]
}
